{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/asset",
      "destination": "/index.html"
    },
    {
      "source": "/ai-canvas",
      "destination": "/index.html"
    },
    {
      "source": "/explore",
      "destination": "/index.html"
    },
    {
      "source": "/elements",
      "destination": "/index.html"
    }
  ]
}
